# =============================================================================
# RunSphere — ตัวอย่าง environment variables
# คัดลอกเป็น .env.local สำหรับเครื่องตัวเอง (ห้าม commit .env.local)
# บน Vercel ให้ใส่ใน Project → Settings → Environment Variables
# =============================================================================

# --- Firebase Web App (public config; ไม่ใช่ secret แต่ต้องตรงกับโปรเจกต์) ---
# Firebase console → Project settings → General → Your apps → Web app → SDK setup and configuration
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Firebase Admin SDK (SECRET — ใช้ฝั่ง server เท่านั้น) ---
# Firebase console → Project settings → Service accounts → Generate new private key
# คัดลอก project_id, client_email, private_key จากไฟล์ JSON ที่ดาวน์โหลด
FIREBASE_PROJECT_ID=your-project
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
# ใส่ทั้งบรรทัดในเครื่องหมายคำพูด โดยคง \n ไว้ตามไฟล์ JSON
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# --- Google Maps JavaScript API ---
# เว้นว่างได้: แอปจะใช้ "แผนที่จำลอง" แทน (ไม่มีค่าใช้จ่าย)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Map ID (สำหรับ Advanced Markers) — เว้นว่างจะใช้ DEMO_MAP_ID
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=

# --- Feature flags ---
# บังคับยืนยันอีเมลก่อนเล่น (ค่าเริ่มต้น: ปิด)
NEXT_PUBLIC_REQUIRE_EMAIL_VERIFICATION=false
# เปิดแผง Mock GPS ใน production build (dev เปิดอัตโนมัติ) — ควรเป็น false ตอนใช้งานจริง
NEXT_PUBLIC_ENABLE_MOCK_GPS=false

# --- Firebase Emulator (ทางเลือก สำหรับทดสอบในเครื่องโดยไม่ใช้โปรเจกต์จริง) ---
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
